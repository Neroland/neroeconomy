{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "NeroEconomy - multiloader build (Fabric).",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  ${access_widener}
  "environment": "*",
  "entrypoints": {
    "main": ["za.co.neroland.neroeconomy.fabric.NeroEconomyFabric"],
    "client": ["za.co.neroland.neroeconomy.fabric.NeroEconomyFabricClient"]
  },
  "mixins": [
    "neroeconomy-common.mixins.json",
    "neroeconomy.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": ">=${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*",
    "nerolandcore": ">=${nerolandcore_version} <2.0.0"
  },
  "suggests": {
    "nerologistics": "*",
    "nerofactions": "*",
    "neroevents": "*",
    "neroquests": "*",
    "nerocreatures": "*"
  }
}
