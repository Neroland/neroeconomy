{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "NeroEconomy - multiloader build (Fabric).",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "icon": "neroeconomy_logo.png",
  ${access_widener}
  "environment": "*",
  "entrypoints": {
    "main": ["za.co.neroland.neroeconomy.fabric.NeroEconomyFabric"],
    "client": ["za.co.neroland.neroeconomy.fabric.NeroEconomyFabricClient"],
    "fabric-gametest": ["za.co.neroland.neroeconomy.fabric.NeroEconomyGameTests"]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=25",
    "fabric-api": "*",
    "nerolandcore": ">=${nerolandcore_version} <2.0.0"
  },
  "suggests": {
    "nerologistics": "*",
    "nerofactions": "*",
    "neroevents": "*",
    "neroquests": "*",
    "nerocreatures": "*"
  }
}
